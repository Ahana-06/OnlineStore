# Copy this file to .env and fill in your own values. .env is in .gitignore, never commit it.

# Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-long-random-string-here

# Leave DATABASE_URL commented out to use the local SQLite file (store.db).
# PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://store_user:your_password@localhost:5432/onlinestore
# MySQL:
# DATABASE_URL=mysql+pymysql://store_user:your_password@localhost:3306/onlinestore
